# Separate ingress surfaces. Only the guest ingress may be forwarded by Tailscale Funnel.
server {
    listen 8080;
    server_name _;
    client_max_body_size 2m;
    add_header X-Content-Type-Options "nosniff" always;

    # Strip any caller-supplied internal operator key, including on public media paths.
    location = / { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /guest-info { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /rsvp { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /gallery { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /contact { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /api/content { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /api/gallery { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /api/rsvp { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /static/guest-site.css { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location = /static/guest-site.js { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    # Fictional artwork only. Do not expose the full application static tree.
    location ^~ /static/demo/ { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location ^~ /media/gallery/ { proxy_set_header X-ECC-Operator-Key ""; proxy_set_header Host $http_host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_pass http://app:8082; }
    location / { return 404; }
}
server {
    listen 8081;
    server_name _;
    client_max_body_size 250m;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        proxy_set_header X-ECC-Operator-Key "${OPERATOR_PROXY_KEY}";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_pass http://app:8082;
    }
}
